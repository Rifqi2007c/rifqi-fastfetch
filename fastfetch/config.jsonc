{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "C:/Users/rifqi/.config/fastfetch/lain.txt"
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": " {#blue} {#white}: {#blue}system information"
    },
    {
      "type": "custom",
      "format": "┌─────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  {#red} > OS: "
    },
    {
      "type": "kernel",
      "key": "  {#red}󰺓 > kernel: "
    },
    {
      "type": "packages",
      "key": "  {#green} > packages: "
    },
    {
      "type": "shell",
      "key": "  {#green} > shell: "
    },
    {
      "type": "wm",
      "key": "  {#yellow} > WM: "
    },
    {
      "type": "de",
      "key": "  {#yellow} > DE: "
    },
    {
      "type": "terminal",
      "key": "  {#yellow} > terminal: "
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────────┘"
    },
    {
      "type": "title",
      "key": " {#yellow} "
    },
    {
      "type": "custom",
      "format": "┌─────────────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  {#blue} > CPU: "
    },
    {
      "type": "gpu",
      "key": "  {#blue}󰢮 > GPU: "
    },
    {
      "type": "memory",
      "key": "  {#magenta} > RAM: "
    },
    {
      "type": "disk",
      "key": "  {#cyan}󰋊 > disk: "
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "             {#black}──{#red}──{#green}──{#yellow}──{#blue}──{#bright_magenta}──{#magenta}──{#dim_white}──"
    },
    {
      "type": "custom",
      "format": "              {#blue}make me sad, {#red}make me mad"
    },
    {
      "type": "custom",
      "format": "                {#green}make me feel alright?"
    }
  ]
}

